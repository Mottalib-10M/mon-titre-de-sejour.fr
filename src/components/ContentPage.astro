---
/**
 * Rendu d'un guide ou d'une page outil défini dans `src/content/`. Ordre (RECETTE §9.3, §21) :
 * H1 et chapeau ; page outil : l'outil, puis le bloc citable replié ; guide : le mini-simulateur, puis
 * le bloc citable, puis le corps (simulateur sur le premier écran, RECETTE §5, règle du 2026-10-11). FAQ, pages associées, sources et encart auteur viennent du
 * PageLayout, avec la FAQ affichée et balisée depuis la même liste (§7).
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import ArbreTitre from './calc/ArbreTitre';
import CoutTitre from './calc/CoutTitre';
import { NaturalisationCalc, MariageCalc } from './calc/Nationalite';
import { ResidentCalc, PluriannuelleCalc, RenouvellementCalc, VlsCalc, DelaiCalc } from './calc/Cartes';
import RegroupementCalc from './calc/Famille';
import { TalentCalc, EmployeurCalc } from './calc/Travail';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById } from '../lib/guides';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef } from '../lib/guide-types';
interface Props { page: PageDef; lang: Locale }
const { page, lang } = Astro.props;
const x = page[lang];
const ui = t(lang);
const path = route(page.id, lang);
const parts = x.body(helpers(lang)).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const jsonLd = [articleSchema({ title: x.h1, description: x.description, path, lang }), webPageSchema({ name: x.h1, description: x.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: x.nav, path }])];
if (page.tool) jsonLd.push(webApplicationSchema({ name: x.h1, description: x.description, path, lang }));
if (x.faqs.length) jsonLd.push(faqSchema(x.faqs, lang));
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id, lang), description: pageById(id)?.[lang].card ?? '' }));
const sources = page.sources.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const methodHref = route('method', lang);
const cible = page.miniHref ?? 'cout-titre-de-sejour';
const miniHref = ROUTES.some((r) => r.id === cible) ? route(cible, lang) : undefined;
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} related={related} sources={sources} breadcrumbs={[{ label: x.nav }]}>
  <article>
    <header class="mb-4">
      <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1>
      <p class="mt-2 text-lg text-navy-700">{x.intro}</p>
      <p class="mt-2 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method', lang)}</a></p>
    </header>
    {page.tool ? (
      <>
        <div data-outil>
          {page.tool === 'arbre' && <ArbreTitre client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'cout' && <CoutTitre client:load lang={lang} methodHref={methodHref} preset={(page.preset ?? 'salarie').split(':')[0]} presetOp={(page.preset ?? '').split(':')[1] ?? 'premiere'} />}
          {page.tool === 'naturalisation' && <NaturalisationCalc client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'mariage' && <MariageCalc client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'resident' && <ResidentCalc client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'pluriannuelle' && <PluriannuelleCalc client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'renouvellement' && <RenouvellementCalc client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'vls' && <VlsCalc client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'delai' && <DelaiCalc client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'regroupement' && <RegroupementCalc client:load lang={lang} methodHref={methodHref} focus="ressources" />}
          {page.tool === 'logement' && <RegroupementCalc client:load lang={lang} methodHref={methodHref} focus="logement" />}
          {page.tool === 'talent' && <TalentCalc client:load lang={lang} methodHref={methodHref} focus={(page.preset as 'talent' | 'cbe' | 'rece') ?? 'talent'} />}
          {page.tool === 'employeur' && <EmployeurCalc client:load lang={lang} methodHref={methodHref} />}
        </div>
        <Clamp text={x.resume} lang={lang} id={`clamp-${page.id}`} class="mt-6 mb-6" />
      </>
    ) : (
      <>
        {page.mini && <MiniSim client:load kind={page.mini} lang={lang} href={miniHref} top={true} />}
        <p class="mb-6 text-navy-800">{x.resume}</p>
      </>
    )}
    <div class="prose prose-slate max-w-none">
      {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <MiniSim client:load kind={p} lang={lang} href={miniHref} />)}
    </div>
  </article>
</PageLayout>
