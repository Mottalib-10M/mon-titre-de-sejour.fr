---
/**
 * Accueil (page pilier, RECETTE §5) : propre au sujet. Ordre : la question « quel titre ? » avec son
 * simulateur (premier écran), le bloc citable replié, le barème des timbres au 1er mai 2026 (tableau
 * généré depuis params), « six calculs que les fiches officielles ne font pas » (cartes avec un
 * chiffre vivant chacune), les délais légaux de silence, puis le texte en accordéon. Texte :
 * src/content/accueil.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import ArbreTitre from './calc/ArbreTitre';
import Clamp from './Clamp.astro';
import { HOME } from '../content/accueil';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label, navCategories } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import type { SourceKey } from '../lib/engine/params';
import { TITRES, hausse2026 } from '../lib/engine/couts';
import { seuilRegroupement } from '../lib/engine/famille';
import { displayDate, formatMoney } from '../lib/format';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED, LANG_TAGS } from '../data/site-config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const fr = lang === 'fr';
const x = HOME[lang];
const h = helpers(lang);
const path = route('home', lang);
const keys: SourceKey[] = ['sp_A18881', 'lf2026_art128', 'sp_F2213', 'sp_F11166', 'sp_F16922', 'sp_F2208', 'insee_smic', 'ceseda_l436', 'cciv_21_14'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const methodHref = route('method', lang);
const d = (iso: string) => displayDate(iso, LANG_TAGS[lang]);
const eur = (n: number, dec = 0) => formatMoney(n, dec, lang);
const has = (id: string) => ROUTES.some((r) => r.id === id);
const go = (id: string) => (has(id) ? route(id, lang) : methodHref);
const T = P.tarifs;
const rf = seuilRegroupement(4, LAST_UPDATED);
const hn = hausse2026('normal', 'premiere');
const tuiles = [
  { id: 'cout-titre-de-sejour', k: fr ? 'Coût réel d’une arrivée salariée sur 3 ans' : 'Real cost of a salaried arrival over 3 years', v: eur(T.vls_ts.normal + T.normal.premiere + T.normal.renouvellement) },
  { id: 'regroupement-familial', k: fr ? `Seuil du regroupement familial à 4 personnes, dépôt du ${d(LAST_UPDATED)}` : `Family-reunification threshold for 4 people, filing on ${d(LAST_UPDATED)}`, v: eur(rf.seuil, 2) },
  { id: 'naturalisation-francaise', k: fr ? 'Délai légal de réponse à une naturalisation' : 'Legal deadline to answer a naturalisation', v: fr ? `${P.naturalisation.delai_mois} mois` : `${P.naturalisation.delai_mois} months` },
  { id: 'passeport-talent', k: fr ? 'Salaire minimal de la carte talent salarié qualifié' : 'Minimum salary for the talent card (skilled employee)', v: eur(P.talent.salaire_ref) },
  { id: 'carte-bleue-europeenne', k: fr ? 'Salaire minimal de la carte bleue européenne' : 'Minimum salary for the EU Blue Card', v: eur(P.talent.cbe) },
  { id: 'renouvellement-titre-de-sejour', k: fr ? 'Dépôt d’un renouvellement : au plus tard' : 'Renewal filing: no later than', v: fr ? `${P.renouvellement.au_plus_tard_mois} mois avant la fin` : `${P.renouvellement.au_plus_tard_mois} months before expiry` },
];
const silence = TITRES.filter((t) => t.implicite_mois || t.implicite_jours);
const parts = x.body(h).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const sections = parts.filter((_, i) => i % 2 === 0).join('').split(/(?=<h2>)/).filter((s) => s.trim());
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-700">{fr ? 'Titres de séjour, nationalité, visas : les calculs' : 'Residence permits, citizenship, visas: the calculations'}</p>
    <h1 class="mt-1 text-3xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1>
    <p class="mt-3 text-lg text-navy-700">{x.intro}</p>
    <p class="mt-2 text-sm text-navy-700">{fr ? 'Barème du' : 'Fees as of'} {d(T.en_vigueur)} · {fr ? 'mis à jour le' : 'updated on'} <time datetime={LAST_UPDATED}>{d(LAST_UPDATED)}</time> · <a href={route('about', lang)} class="underline">{label('about', lang)}</a> · <a href={methodHref} class="underline">{label('method', lang)}</a> · <a href={P.sources.sp_A18881.url} class="underline" rel="nofollow noopener" target="_blank">{fr ? 'Service-Public.fr' : 'Service-Public.fr (official)'}</a></p>
  </header>
  <section aria-label={fr ? 'Quel titre pour ma situation' : 'Which permit for my situation'}>
    <ArbreTitre client:load lang={lang} methodHref={methodHref} />
  </section>
  <Clamp text={x.resume} lang={lang} id="clamp-home" sentences={1} class="mt-6 mb-2" />

  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{fr ? 'Six calculs que les fiches officielles ne font pas' : 'Six calculations the official pages leave to you'}</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {tuiles.map((t) => (
        <li><a href={go(t.id)} class="block h-full rounded-lg border border-navy-200 p-4 hover:border-accent-400">
          <span class="block text-sm text-navy-700">{t.k}</span>
          <span class="tabular-nums mt-1 block text-2xl font-bold text-navy-900">{t.v}</span>
          <span class="mt-1 block text-sm font-medium text-accent-700">{label(t.id, lang)} →</span>
        </a></li>))}
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{fr ? `Timbres fiscaux : le barème en vigueur depuis le ${d(T.en_vigueur)}` : `Tax stamps: the schedule in force since ${d(T.en_vigueur)}`}</h2>
    <p class="mt-2 text-navy-800">{fr ? `La loi de finances pour 2026 a relevé tous les montants. Une première carte au tarif normal coûte ${eur(hn.apres)} contre ${eur(hn.avant)} avant cette date ; le montant dû est celui en vigueur le jour de la décision.` : `The 2026 Finance Act raised every amount. A first card at the standard rate costs ${eur(hn.apres)}, up from ${eur(hn.avant)}; what you owe is the amount in force on the day of the decision.`}</p>
    <div class="not-prose my-4 overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr class="border-b border-navy-300 text-left text-xs uppercase tracking-wide text-navy-700"><th scope="col" class="py-2 pr-3">{fr ? 'Démarche' : 'Procedure'}</th><th scope="col" class="py-2 pr-3 text-right">{fr ? 'Tarif normal' : 'Standard'}</th><th scope="col" class="py-2 pr-3 text-right">{fr ? 'Tarif minoré' : 'Reduced'}</th><th scope="col" class="py-2 text-right">{fr ? 'Avant mai 2026' : 'Before May 2026'}</th></tr></thead>
        <tbody>
          <tr class="border-b border-navy-100"><td class="py-2 pr-3">{fr ? 'Première carte de séjour ou de résident' : 'First residence or resident card'}</td><td class="tabular-nums py-2 pr-3 text-right">{eur(T.normal.premiere)}</td><td class="tabular-nums py-2 pr-3 text-right">{eur(T.minore.premiere)}</td><td class="tabular-nums py-2 text-right">{eur(T.anciens.premiere)} / {eur(T.anciens.premiere_minore)}</td></tr>
          <tr class="border-b border-navy-100"><td class="py-2 pr-3">{fr ? 'Renouvellement' : 'Renewal'}</td><td class="tabular-nums py-2 pr-3 text-right">{eur(T.normal.renouvellement)}</td><td class="tabular-nums py-2 pr-3 text-right">{eur(T.minore.renouvellement)}</td><td class="tabular-nums py-2 text-right">{eur(T.anciens.renouvellement)} / {eur(T.anciens.renouvellement_minore)}</td></tr>
          <tr class="border-b border-navy-100"><td class="py-2 pr-3">{fr ? 'Duplicata (perte, vol)' : 'Replacement (loss, theft)'}</td><td class="tabular-nums py-2 pr-3 text-right">{eur(T.normal.duplicata)}</td><td class="tabular-nums py-2 pr-3 text-right">{eur(T.minore.duplicata)}</td><td class="tabular-nums py-2 text-right">-</td></tr>
          <tr class="border-b border-navy-100"><td class="py-2 pr-3">{fr ? 'Validation du VLS-TS' : 'VLS-TS validation'}</td><td class="tabular-nums py-2 pr-3 text-right">{eur(T.vls_ts.normal)}</td><td class="tabular-nums py-2 pr-3 text-right">{eur(T.vls_ts.minore)}</td><td class="tabular-nums py-2 text-right">{eur(T.anciens.vls_ts)}</td></tr>
          <tr class="border-b border-navy-100"><td class="py-2 pr-3">{fr ? 'Visa de régularisation (entrée sans visa)' : 'Regularisation visa (entry without visa)'}</td><td class="tabular-nums py-2 pr-3 text-right" colspan="2">{eur(T.visa_regularisation)}</td><td class="tabular-nums py-2 text-right">{eur(T.anciens.visa_regularisation)}</td></tr>
          <tr class="border-b border-navy-100"><td class="py-2 pr-3">{fr ? 'Naturalisation, déclaration par mariage' : 'Naturalisation, declaration by marriage'}</td><td class="tabular-nums py-2 pr-3 text-right" colspan="2">{eur(T.nationalite)}</td><td class="tabular-nums py-2 text-right">{eur(T.anciens.nationalite)}</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-sm text-navy-700">{fr ? 'Tarif minoré : étudiant, saisonnier, recherche d’emploi, regroupement familial, jeune au pair, stagiaire. Droit de timbre seul (' : 'Reduced rate: student, seasonal worker, job search, family reunification, au pair, trainee. Stamp duty only ('}{eur(T.droit_timbre)}{fr ? ') : retraité, étranger malade, famille d’un réfugié. ' : '): retiree, medical grounds, refugee’s family. '}<a href={go('timbre-fiscal-titre-de-sejour')} class="underline">{label('timbre-fiscal-titre-de-sejour', lang)}</a></p>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{fr ? 'Délais : ce que la loi fixe, ce que personne ne publie' : 'Waiting times: what the law sets, what nobody publishes'}</h2>
    <p class="mt-2 text-navy-800">{fr ? 'Aucune préfecture ne publie ses délais moyens de traitement. Le seul délai certain est celui au terme duquel le silence de l’administration vaut refus, ce qui ouvre le recours.' : 'No prefecture publishes average processing times. The only certain period is the one after which the administration’s silence counts as refusal, which opens the right to appeal.'}</p>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {silence.slice(0, 12).map((t) => <li class="rounded border border-navy-200 px-3 py-2 text-sm"><span class="text-navy-900">{t.label[lang]}</span><span class="tabular-nums float-right font-semibold text-navy-900">{t.implicite_mois ? `${t.implicite_mois} ${fr ? 'mois' : 'mo'}` : `${t.implicite_jours} ${fr ? 'j' : 'd'}`}</span></li>)}
    </ul>
    <p class="mt-2 text-sm"><a href={go('delai-titre-de-sejour')} class="underline">{label('delai-titre-de-sejour', lang)}</a></p>
  </section>

  <nav class="mt-10" aria-label={fr ? 'Toutes les pages' : 'All pages'}>
    <h2 class="text-2xl font-bold text-navy-900">{fr ? 'Chaque titre, chaque démarche, son propre calcul' : 'Every permit, every procedure, its own calculation'}</h2>
    <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {navCategories(lang).map((c) => (<div><p class="font-semibold text-navy-900">{c.label}</p><ul class="mt-1 space-y-1 text-sm">{c.links.map((l) => <li><a href={l.href} class="text-navy-800 underline-offset-2 hover:underline">{l.label}</a></li>)}</ul></div>))}
    </div>
  </nav>

  <div class="mt-10 space-y-3">
    {sections.map((s, i) => (
      <details class="group rounded-lg border border-navy-200 bg-white" open={i === 0}>
        <summary class="cursor-pointer px-5 py-4 text-lg font-semibold text-navy-900"><Fragment set:html={(s.match(/<h2>(.*?)<\/h2>/) ?? ['', ''])[1]} /></summary>
        <div class="prose prose-slate max-w-none px-5 pb-5"><Fragment set:html={s.replace(/<h2>.*?<\/h2>/, '')} /></div>
      </details>))}
  </div>
  <p class="mt-6 text-sm text-navy-700">{fr ? 'Données au' : 'Data as of'} <time datetime={LAST_UPDATED}>{d(LAST_UPDATED)}</time> · {fr ? 'Smic de' : 'Minimum wage'} {eur(P.smic.historique[P.smic.historique.length - 1].mensuel, 2)} {fr ? 'depuis le' : 'since'} {d(P.smic.historique[P.smic.historique.length - 1].depuis)}</p>
</PageLayout>
