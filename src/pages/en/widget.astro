---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/which-permit/" title="Embed the calculator" width="100%" height="1150" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the residence permit calculator: free iframe code" description="Embed the which-permit calculator for France free of charge: matching permit, tax-stamp cost and next steps, with no sign-up and no cookies, all calculated in the browser." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One code to copy, no sign-up and no fee. The iframe loads the full calculator: the permit that matches the situation, first-year tax-stamp cost and the steps towards the resident card and citizenship.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link below the calculator stays visible, the calculator is not altered and comes without warranty. We keep the fee schedules current here, so your embed stays up to date. French version: <code>{`${SITE_URL}/embed/quel-titre/`}</code>.</p>
    <p>Your readers' inputs stay on their device; the embedded frame sets no cookies. Questions: see the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/which-permit/" title="Embed the calculator" width="100%" height="1150" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
